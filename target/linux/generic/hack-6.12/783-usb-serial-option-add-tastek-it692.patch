From: ImmortalWrt DTU <firmware@example.invalid>
Subject: [PATCH] usb: serial: option: support Tastek IT-692 modem

--- a/drivers/usb/serial/option.c
+++ b/drivers/usb/serial/option.c
@@ -1171,6 +1171,8 @@
 	{ USB_DEVICE_AND_INTERFACE_INFO(MEIGLINK_VENDOR_ID, MEIGLINK_PRODUCT_SLM828, USB_CLASS_VENDOR_SPEC, 0x10, 0x04) },
 	/* Tastek IT-694 / Marvell Mobile Composite Device Bus */
 	{ USB_DEVICE(0x1286, 0x4e3c) },
+	/* Tastek IT-692: leave the RNDIS interfaces to rndis_host. */
+	{ USB_DEVICE_INTERFACE_CLASS(0x3505, 0x0003, USB_CLASS_VENDOR_SPEC) },
 	/* Quectel products using Qualcomm vendor ID */
 	{ USB_DEVICE(QUALCOMM_VENDOR_ID, QUECTEL_PRODUCT_UC15)},
 	{ USB_DEVICE(QUALCOMM_VENDOR_ID, QUECTEL_PRODUCT_UC20),
