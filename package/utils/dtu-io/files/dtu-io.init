#!/bin/sh /etc/rc.common

USE_PROCD=1
START=93
STOP=12

start_service() {
	procd_open_instance
	procd_set_param command /usr/sbin/dtu-io
	procd_set_param respawn 3600 5 -1
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	# Reload labels, input interpretation and control permissions without
	# releasing GPIO requests or resetting manually selected output levels.
	ubus call dtu.io reload '{}' >/dev/null
}

service_triggers() {
	procd_add_reload_trigger dtu_io
}
