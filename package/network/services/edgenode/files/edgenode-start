#!/bin/sh

# 4GINFO owns modem probing and persists a valid IMEI. The daemon keeps its
# event loop and watchdog alive while waiting, before starting platform sessions.
mkdir -p /tmp/edgenode
# Opt in with the PID preserved by exec; old binaries without this launcher
# are not treated as stalled merely because they lack the new health file.
echo "$$" >/tmp/edgenode/loop.watchdog
exec /usr/sbin/edgenode
