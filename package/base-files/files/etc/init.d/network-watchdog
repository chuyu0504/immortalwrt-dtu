#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

start_service() {
	local reboot_on_offline

	config_load network_watchdog
	config_get_bool reboot_on_offline main reboot_on_offline 1

	procd_open_instance
	procd_set_param command /usr/sbin/network-watchdog
	procd_set_param env NETWORK_WATCHDOG_REBOOT_ON_OFFLINE="$reboot_on_offline"
	procd_set_param respawn 3600 5 -1
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
